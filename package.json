{
  "name": "taxonomap",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check && vue-tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "test:e2e": "playwright test",
    "worker:dev": "wrangler dev --config worker/wrangler.toml",
    "worker:deploy": "wrangler deploy --config worker/wrangler.toml"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/vue": "^7.0.3",
    "@fontsource-variable/lexend": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@fontsource/patrick-hand": "^5.3.0",
    "@mapbox/point-geometry": "^1.1.0",
    "@mapbox/vector-tile": "^3.0.0",
    "@maplibre/vt-pbf": "^4.3.2",
    "@nanostores/vue": "^1.1.0",
    "@observablehq/plot": "^0.6.17",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.8",
    "d3-hierarchy": "^3.1.2",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "maplibre-gl": "^6.14.0",
    "nanostores": "^1.5.5",
    "p-limit": "^7.3.3",
    "pbf": "^5.1.2",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.43",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@fontsource/lexend": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.1",
    "@playwright/test": "^1.64.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "satori": "^0.51.0",
    "typescript": "~6.0",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.13",
    "workbox-build": "^7.4.1",
    "wrangler": "^4.149.0"
  }
}
