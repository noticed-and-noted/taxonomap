# Copy to .env and adjust. PUBLIC_* values are inlined into the client bundle.

# JSON API base. Swap for a Cloudflare Worker cache (see /worker) without code changes.
PUBLIC_GBIF_API_BASE=https://api.gbif.org
# Map tile base (density + adhoc tiles).
PUBLIC_GBIF_TILE_BASE=https://api.gbif.org

# Canonical site URL (sitemap, Open Graph).
PUBLIC_SITE_URL=https://gbif-explorer.pages.dev

# Build-time only: contact address sent in the User-Agent to GBIF.
GBIF_CONTACT_EMAIL=you@example.org
# Build-time disk cache TTL in hours (default 168 = 7 days). Set GBIF_CACHE_REFRESH=1 to bypass.
GBIF_CACHE_TTL_HOURS=168
GBIF_CACHE_REFRESH=0

# Common-name index for the omnibox (/data/names.json). Each species costs two
# cached GBIF requests at build. Dev defaults to 300.
NAME_INDEX_SIZE=6000

# Place search (submit only). nominatim | photon, plus optional endpoint override.
PUBLIC_GEOCODER=nominatim
# PUBLIC_GEOCODER_URL=

# Optional basemap overrides (defaults: OpenFreeMap dark/positron, OpenTopoMap, EOX Sentinel-2).
# PUBLIC_BASEMAP_PLAIN_DARK=
# PUBLIC_BASEMAP_PLAIN_LIGHT=
# PUBLIC_BASEMAP_TERRAIN=
# PUBLIC_BASEMAP_SATELLITE=

# Number of species pages pre-rendered at build (Phase 3).
SPECIES_PRERENDER_COUNT=2000

# Where requests go when the edge cache (PUBLIC_GBIF_API_BASE / PUBLIC_GBIF_TILE_BASE) is down.
# PUBLIC_GBIF_FALLBACK_BASE=https://api.gbif.org
