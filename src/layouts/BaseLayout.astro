---
import { ClientRouter } from 'astro:transitions';
import { GBIF_API_BASE } from '~/lib/gbif/config';
import '~/styles/global.css';
import sansLatin from '@fontsource-variable/lexend/files/lexend-latin-wght-normal.woff2?url';
import serifLatin from '@fontsource-variable/source-serif-4/files/source-serif-4-latin-wght-normal.woff2?url';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
  canonical?: string;
}

const {
  title,
  description = 'Explore where the world’s species have been recorded, with maps and charts built on GBIF occurrence data.',
  ogImage,
  noindex = false,
  canonical,
} = Astro.props;

const siteName = 'Taxonomap';
const fullTitle = title === siteName ? title : `${title} · ${siteName}`;
const canonicalUrl = canonical ?? (Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined);
const ogImageUrl = ogImage && Astro.site ? new URL(ogImage, Astro.site).href : undefined;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {canonicalUrl && !noindex && <link rel="canonical" href={canonicalUrl} />}
    <meta name="theme-color" content="#0e1813" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="preconnect" href={GBIF_API_BASE} crossorigin />
    <link rel="preconnect" href="https://tiles.openfreemap.org" crossorigin />
    <link rel="preload" href={sansLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={serifLatin} as="font" type="font/woff2" crossorigin />

    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    <meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />

    <!-- Apply the saved theme before first paint, and again after each client-side swap. -->
    <script is:inline>
      (() => {
        const apply = (doc) => {
          let savedTheme = null;
          try {
            savedTheme = localStorage.getItem('theme');
          } catch {
            /* storage blocked: fall back to the dark default */
          }
          doc.documentElement.dataset.theme = savedTheme === 'light' ? 'light' : 'dark';
        };
        apply(document);
        document.addEventListener('astro:before-swap', (event) => apply(event.newDocument));
        // Hide photos that fail to load (some GBIF media are gone), including
        // on static, non-hydrated cards. Error events don't bubble; capture does.
        document.addEventListener(
          'error',
          (event) => {
            const target = event.target;
            if (target instanceof HTMLImageElement && target.hasAttribute('data-hide-on-error')) {
              target.style.visibility = 'hidden';
            }
          },
          true,
        );
      })();
    </script>
    <ClientRouter fallback="swap" />
    <slot name="head" />
  </head>
  <body class="bg-bg text-text">
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <slot />

    <script>
      import { MINUTE } from '~/lib/util/time';
      import { $applyUpdate } from '~/stores/app-update';

      const UPDATE_CHECK_INTERVAL_MS = 5 * MINUTE;
      const MIN_UPDATE_CHECK_GAP_MS = MINUTE;

      // ClientRouter waits for the next page's HTML before swapping; on a slow link that looks like a dead click.
      // Show the loading bar and move the header's current-page mark straight away instead.
      const trimSlash = (pathname: string) => pathname.replace(/\/$/, '') || '/';
      document.addEventListener('astro:before-preparation', (event) => {
        document.documentElement.dataset.navigating = '';
        const target = trimSlash(event.to.pathname);
        for (const link of document.querySelectorAll<HTMLAnchorElement>('.nav-link')) {
          if (trimSlash(link.pathname) === target) link.setAttribute('aria-current', 'page');
          else link.removeAttribute('aria-current');
        }
      });
      document.addEventListener('astro:after-preparation', () => delete document.documentElement.dataset.navigating);

      if (import.meta.env.PROD && 'serviceWorker' in navigator) {
        void import('workbox-window').then(({ Workbox }) => {
          const wb = new Workbox('/sw.js');
          let isUpdateRequested = false;
          wb.addEventListener('waiting', () =>
            $applyUpdate.set(() => {
              isUpdateRequested = true;
              wb.messageSkipWaiting();
            }),
          );
          // Workbox's isUpdate stays false for a page first opened without a worker, so track it here:
          // the first worker to take control on a first visit isn't an update.
          let hasWorker = Boolean(navigator.serviceWorker.controller);
          // This tab asked for the update: reload into it. Another tab did: offer the reload here too.
          wb.addEventListener('controlling', () => {
            if (isUpdateRequested) window.location.reload();
            else if (hasWorker) $applyUpdate.set(() => window.location.reload());
            hasWorker = true;
          });
          // Browsers only check for a new worker on full page loads; ClientRouter swaps aren't, so check here too,
          // and on a timer so an open tab hears about a deploy (sw.js is no-cache, so a check is a cheap 304).
          // Registering already checked, so the clock starts now; quick tab flips then don't each ask again.
          let lastCheckedAt = Date.now();
          const checkForUpdate = () => {
            if (document.visibilityState !== 'visible' || Date.now() - lastCheckedAt < MIN_UPDATE_CHECK_GAP_MS) return;
            lastCheckedAt = Date.now();
            void wb.update();
          };
          document.addEventListener('astro:after-swap', checkForUpdate);
          document.addEventListener('visibilitychange', checkForUpdate);
          setInterval(checkForUpdate, UPDATE_CHECK_INTERVAL_MS);
          void wb.register();
        });
        // Offline, the worker answers every page with the offline page: reload into it rather than show a broken app.
        // Listen straight away, not once workbox-window loads, or a connection lost while it loads goes unnoticed.
        window.addEventListener('offline', () => {
          if (navigator.serviceWorker.controller && !document.querySelector('[data-offline-page]')) {
            window.location.reload();
          }
        });
      }

      // Dev only: Vite injects client:only island CSS into <head>, the server
      // HTML of the next page doesn't list it, so ClientRouter drops it on swap
      // and Vite never re-injects (module already loaded). Carry it across.
      if (import.meta.env.DEV) {
        document.addEventListener('astro:before-swap', (event) => {
          const head = event.newDocument.head;
          for (const style of document.head.querySelectorAll('style[data-vite-dev-id]')) {
            const id = style.getAttribute('data-vite-dev-id');
            if (!head.querySelector(`style[data-vite-dev-id="${CSS.escape(id!)}"]`)) {
              head.append(style.cloneNode(true));
            }
          }
        });
      }
    </script>
  </body>
</html>
