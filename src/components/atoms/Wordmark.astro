---
import { BALL, COIL, COIL_STROKE_WIDTH, LEAF, MARK_VIEWBOX } from '~/lib/wordmark';

/**
 * The Taxonomap logo: the fern mark to the left of the word, laid out as on the brand board. The word is real
 * text in the wordmark font (global.css), so it renders as the board does at every size. Coloured from the
 * theme tokens. Decorative (the surrounding link carries the label); sized by the parent's font-size.
 */
interface Props {
  /** Below 640 px show the mark alone, as the header does. */
  compact?: boolean;
  /** Show the mark alone at every width. */
  fernOnly?: boolean;
}

const { compact = false, fernOnly = false } = Astro.props;
---

<span class:list={['wordmark', { compact, 'fern-only': fernOnly }]} aria-hidden="true">
  <svg class="mark" viewBox={MARK_VIEWBOX}>
    <path class="ball" d={BALL} />
    <path class="coil" d={COIL} stroke-width={COIL_STROKE_WIDTH} />
    <path class="leaf" d={LEAF} />
  </svg>
  <span class="word">Taxonomap</span>
</span>

<style>
  .wordmark {
    display: flex;
    align-items: center;
    gap: 0.19em;
    line-height: 1;
    white-space: nowrap;
  }

  /* The mark is 1.1 times the type size; 110 x 129 units. */
  .mark {
    flex: none;
    width: 0.938em;
    height: 1.1em;
  }

  .word {
    font-family: 'Taxonomap Wordmark', var(--font-serif);
    font-weight: 600;
    letter-spacing: 0.045em;
    color: var(--text);
  }

  .ball {
    fill: var(--accent);
  }

  .coil {
    fill: none;
    stroke: var(--accent);
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .leaf {
    fill: var(--leaf);
  }

  .fern-only .word {
    display: none;
  }

  @media (max-width: 639.98px) {
    .compact .word {
      display: none;
    }
  }
</style>
