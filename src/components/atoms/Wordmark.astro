---
import { BALL, COIL, COIL_STROKE_WIDTH, LEAF, LOCKUP, MARK_VIEWBOX } from '~/lib/wordmark';

/**
 * The Taxonomap logo, drawn from the designed artwork (docs/brand/wordmark-light.svg): the fern mark beside the
 * outlined word. Coloured from the theme tokens. Decorative (the surrounding link carries the label); the word
 * is 1em, so the logo sizes from the parent's font-size.
 */
interface Props {
  /** Below 640 px show the mark alone, as the header does. */
  compact?: boolean;
  /** Show the mark alone at every width. */
  fernOnly?: boolean;
}

const { compact = false, fernOnly = false } = Astro.props;
---

<span class:list={['wordmark', { compact, 'fern-only': fernOnly }]} aria-hidden="true">
  <svg class="full" viewBox={LOCKUP.viewBox}>
    <path class="ball" d={LOCKUP.ball} />
    <path class="coil" d={LOCKUP.coil} stroke-width={LOCKUP.coilStrokeWidth} />
    <path class="leaf" d={LOCKUP.leaf} />
    <path class="letters" d={LOCKUP.letters} />
  </svg>
  <svg class="fern-alone" viewBox={MARK_VIEWBOX}>
    <path class="ball" d={BALL} />
    <path class="coil" d={COIL} stroke-width={COIL_STROKE_WIDTH} />
    <path class="leaf" d={LEAF} />
  </svg>
</span>

<style>
  .wordmark {
    display: flex;
    line-height: 1;
  }

  /* 652.5 x 115 artwork units (LOCKUP's viewBox) at 104.78 to the em. The p's tail makes the box deeper below
     the logo than above it, so it drops 5 units: a container that centres the box then centres the mark and
     capitals. A translate moves the drawing without changing the space it takes. */
  .full {
    width: 6.227em;
    height: 1.098em;
    translate: 0 0.048em;
  }

  /* The mark's own bounds, 110 x 129 units, at the lockup's mark height. */
  .fern-alone {
    display: none;
    width: 0.863em;
    height: 1.012em;
  }

  .letters {
    fill: var(--text);
  }

  .ball {
    fill: var(--accent);
  }

  .coil {
    fill: none;
    stroke: var(--accent);
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .leaf {
    fill: var(--leaf);
  }

  .fern-only .full {
    display: none;
  }

  .fern-only .fern-alone {
    display: block;
  }

  @media (max-width: 639.98px) {
    .compact .full {
      display: none;
    }

    .compact .fern-alone {
      display: block;
    }
  }
</style>
