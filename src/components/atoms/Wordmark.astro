---
import { BALL, COIL, COIL_STROKE_WIDTH, LEAF, LETTERS, LOCKUP_VIEWBOX, MARK_VIEWBOX } from '~/lib/wordmark';

/**
 * The Taxonomap logo: the fern mark to the left of the wordmark, from docs/brand/wordmark-light.svg (Fraunces
 * letters, outlined, so no font loads). Coloured from the theme tokens. Decorative (the surrounding link
 * carries the label); the mark is 1.1em tall, so the logo sizes from the parent's font-size.
 */
interface Props {
  /** Below 640 px show the mark alone, as the header does. */
  compact?: boolean;
  /** Show the mark alone at every width. */
  fernOnly?: boolean;
}

const { compact = false, fernOnly = false } = Astro.props;
---

<span class:list={['wordmark', { compact, 'fern-only': fernOnly }]} aria-hidden="true">
  <svg class="full" viewBox={LOCKUP_VIEWBOX}>
    <path class="ball" d={BALL} />
    <path class="coil" d={COIL} stroke-width={COIL_STROKE_WIDTH} />
    <path class="leaf" d={LEAF} />
    <g class="letters">
      {LETTERS.map((path) => (
        <path d={path} />
      ))}
    </g>
  </svg>
  <svg class="fern-alone" viewBox={MARK_VIEWBOX}>
    <path class="ball" d={BALL} />
    <path class="coil" d={COIL} stroke-width={COIL_STROKE_WIDTH} />
    <path class="leaf" d={LEAF} />
  </svg>
</span>

<style>
  .wordmark {
    display: flex;
    line-height: 1;
  }

  /* 795 x 129 mark units, with the mark's 129 units at 1.1em. The p's tail hangs just below. */
  .full {
    width: 6.779em;
    height: 1.1em;
    overflow: visible;
  }

  /* The mark's own bounds, 110 x 129 units. */
  .fern-alone {
    display: none;
    width: 0.938em;
    height: 1.1em;
  }

  .letters {
    fill: var(--text);
  }

  .ball {
    fill: var(--accent);
  }

  .coil {
    fill: none;
    stroke: var(--accent);
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .leaf {
    fill: var(--leaf);
  }

  .fern-only .full {
    display: none;
  }

  .fern-only .fern-alone {
    display: block;
  }

  @media (max-width: 639.98px) {
    .compact .full {
      display: none;
    }

    .compact .fern-alone {
      display: block;
    }
  }
</style>
