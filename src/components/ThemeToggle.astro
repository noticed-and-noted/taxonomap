---
/** Dark/light switch. No island: a tiny delegated script, registered once. */
---

<button
  type="button"
  data-theme-toggle
  class="inline-grid size-11 sm:size-9 place-items-center rounded-md text-muted transition-colors duration-200 hover:bg-surface-2 hover:text-text"
  aria-label="Switch to light theme"
  title="Switch theme"
>
  <svg
    class="theme-icon-sun size-5"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
  </svg>
  <svg
    class="theme-icon-moon size-5"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    aria-hidden="true"
  >
    <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"></path>
  </svg>
</button>

<style>
  :global([data-theme='dark']) .theme-icon-moon,
  :global([data-theme='light']) .theme-icon-sun {
    display: none;
  }
</style>

<script>
  const label = () =>
    document.documentElement.dataset['theme'] === 'light' ? 'Switch to dark theme' : 'Switch to light theme';

  const syncLabels = () => {
    for (const button of document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')) {
      button.setAttribute('aria-label', label());
    }
  };

  document.addEventListener('click', (event) => {
    const btn = (event.target as Element | null)?.closest('[data-theme-toggle]');
    if (!btn) return;
    const next = document.documentElement.dataset['theme'] === 'light' ? 'dark' : 'light';
    document.documentElement.dataset['theme'] = next;
    try {
      localStorage.setItem('theme', next);
    } catch {
      /* storage unavailable: theme applies for this page view only */
    }
    syncLabels();
    document.dispatchEvent(new CustomEvent('themechange', { detail: next }));
  });

  document.addEventListener('astro:page-load', syncLabels);
</script>
