---
/** Site header: brand, omnibox (client:idle), main navigation, theme toggle. */
import Omnibox, { type SearchMode } from './vue/Omnibox.vue';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  /** What picking a search result does on this page. */
  search: SearchMode;
}

const { search } = Astro.props;

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const nav = [
  { href: '/', label: 'Map', icon: 'M3 6l6-2 6 2 6-2v14l-6 2-6-2-6 2zM9 4v14M15 6v14' },
  {
    href: '/tree',
    label: 'Tree of life',
    icon: 'M12 21V11M12 11c0-4 3-6 7-6 0 4-3 6-7 6zM12 14c0-3-2.5-5-6-5 0 3 2.5 5 6 5z',
  },
];
---

<header class="app-header">
  <a href="/" class="brand pill flex items-center px-3.5">
    <span class="sr-only">Taxonomap home</span>
    <span class="wordmark" aria-hidden="true">
      <span class="brand-label">tax</span>
      {/* The fern stands in for the first "o"; its stem and leaflets hang below the baseline. */}
      <svg viewBox="16 7 32 53" class="fern">
        <path
          d="M40 58C40 48 40 37 32 37"
          fill="none"
          stroke="var(--accent)"
          stroke-width="4.5"
          stroke-linecap="round"
        ></path>
        <g transform="translate(17 8.5) scale(0.75)">
          <path
            d="M20 38A18 18 0 0 1 20 2A14 14 0 0 1 20 30A8 8 0 0 1 20 14"
            fill="none"
            stroke="var(--accent)"
            stroke-width="6"
            stroke-linecap="round"
          ></path>
          <circle cx="20.5" cy="14" r="3.6" fill="var(--accent)"></circle>
        </g>
        <path d="M40 51C35 50 31 47 30 43C35 43 38 46 40 51Z" fill="var(--text-muted)"></path>
        <path d="M40 46C44 44 48 44 51 41C50 46 45 48 40 46Z" fill="var(--text-muted)"></path>
      </svg>
      <span class="brand-label">nomap</span>
    </span>
  </a>

  <div class="search-slot min-w-0 flex-1">
    <Omnibox client:idle mode={search} />
  </div>

  <nav aria-label="Main" class="pill p-1">
    <ul class="flex h-full items-center gap-1 text-sm">
      {nav.map((item) => (
        <li>
          <a
            href={item.href}
            class="nav-link relative flex items-center gap-1.5 rounded-[calc(var(--radius)-4px)] px-2.5 py-1.5 text-muted transition-colors duration-200 hover:bg-surface-2 hover:text-text aria-[current=page]:text-text"
            aria-current={path === item.href ? 'page' : undefined}
          >
            <svg
              viewBox="0 0 24 24"
              class="nav-icon size-5"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d={item.icon} />
            </svg>
            <span class="nav-label">{item.label}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
  {/* On the map, phones get the toggle in the Filters sheet's Map tab instead. */}
  <div class:list={['pill theme-pill', { 'theme-pill-map': path === '/' }]}>
    <ThemeToggle />
  </div>
</header>

<style>
  /* Floating: no bar of its own, just separate pills over the page. */
  .app-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    height: var(--header-height);
    margin: var(--header-gap) var(--header-gap) 0;
    pointer-events: none;
    z-index: 30;
  }

  .app-header > :global(*),
  .search-slot > :global(*) {
    pointer-events: auto;
  }

  /* The slot stretches to the nav; only the search box itself is solid. */
  .app-header > .search-slot {
    pointer-events: none;
  }

  .pill {
    height: 100%;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow);
  }

  /* Sizes are tied to Patrick Hand's x-height (0.467em) so the fern's coil matches the lowercase letters. */
  .wordmark {
    display: flex;
    align-items: baseline;
    font-family: var(--font-hand);
    font-size: 2rem;
    line-height: 1;
    color: var(--text);
    transform: translateY(-0.12em);
  }

  .fern {
    flex: none;
    width: 0.474em;
    height: 0.786em;
    margin: 0 0.02em;
    overflow: visible;
    transform: translateY(0.308em);
  }

  .theme-pill {
    display: grid;
    place-items: center;
    aspect-ratio: 1;
  }

  /* A straight bar, not an inset shadow, so it ignores the link's rounded corners. */
  .nav-link[aria-current='page']::after {
    content: '';
    position: absolute;
    inset: auto calc(0.625rem - 2px) 1px;
    height: 2px;
    border-radius: 1px;
    background: var(--accent);
  }

  .nav-icon {
    display: none;
  }

  @media (max-width: 1023.98px) {
    .nav-label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    .nav-icon {
      display: block;
    }
  }

  @media (max-width: 639.98px) {
    .brand-label {
      display: none;
    }
    .app-header {
      gap: 0.375rem;
    }
    .theme-pill-map {
      display: none;
    }
  }
</style>
