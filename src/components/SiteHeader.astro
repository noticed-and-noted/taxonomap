---
/** Site header: brand, omnibox (client:idle), main navigation, theme toggle. */
import Omnibox, { type SearchMode } from './vue/Omnibox.vue';
import ThemeToggle from './ThemeToggle.astro';
import Wordmark from './Wordmark.astro';

interface Props {
  /** What picking a search result does on this page. */
  search: SearchMode;
}

const { search } = Astro.props;

const trimSlash = (pathname: string) => pathname.replace(/\/$/, '') || '/';
const path = trimSlash(Astro.url.pathname);
const nav = [
  { href: '/', label: 'Map', icon: 'M3 6l6-2 6 2 6-2v14l-6 2-6-2-6 2zM9 4v14M15 6v14' },
  {
    href: '/tree/',
    label: 'Tree of life',
    icon: 'M12 21V11M12 11c0-4 3-6 7-6 0 4-3 6-7 6zM12 14c0-3-2.5-5-6-5 0 3 2.5 5 6 5z',
  },
];
---

<header class="app-header">
  <a href="/" class="brand pill flex items-center px-3.5 text-[2rem]">
    <span class="sr-only">Taxonomap home</span>
    <Wordmark compact />
  </a>

  <div class="search-slot min-w-0 flex-1">
    <Omnibox client:idle mode={search} />
  </div>

  <nav aria-label="Main" class="pill p-1" data-tour="nav">
    <ul class="flex h-full items-center gap-1 text-sm">
      {nav.map((item) => (
        <li>
          <a
            href={item.href}
            class="nav-link relative flex items-center gap-1.5 rounded-[calc(var(--radius)-4px)] px-2.5 py-1.5 text-muted transition-colors duration-200 hover:bg-surface-2 hover:text-text aria-[current=page]:text-text"
            aria-current={path === trimSlash(item.href) ? 'page' : undefined}
          >
            <svg
              viewBox="0 0 24 24"
              class="nav-icon size-5"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d={item.icon} />
            </svg>
            <span class="nav-label">{item.label}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
  {/* Phones get the theme picker in the map's Settings instead. */}
  <div class="pill theme-pill">
    <ThemeToggle />
  </div>
</header>

<style>
  /* Floating: no bar of its own, just separate pills over the page. */
  .app-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    height: var(--header-height);
    margin: var(--header-gap) var(--header-gap) 0;
    pointer-events: none;
    z-index: 30;
  }

  .app-header > :global(*),
  .search-slot > :global(*) {
    pointer-events: auto;
  }

  /* The slot stretches to the nav; only the search box itself is solid. */
  .app-header > .search-slot {
    pointer-events: none;
  }

  .pill {
    height: 100%;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow);
  }

  .theme-pill {
    display: grid;
    place-items: center;
    aspect-ratio: 1;
  }

  /* A straight bar, not an inset shadow, so it ignores the link's rounded corners. */
  .nav-link[aria-current='page']::after {
    content: '';
    position: absolute;
    inset: auto calc(0.625rem - 2px) 1px;
    height: 2px;
    border-radius: 1px;
    background: var(--accent);
  }

  .nav-icon {
    display: none;
  }

  @media (max-width: 1023.98px) {
    .nav-label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    .nav-icon {
      display: block;
    }
  }

  @media (max-width: 639.98px) {
    .app-header {
      gap: 0.375rem;
    }
    .theme-pill {
      display: none;
    }
  }
</style>
