<span class:list={['wordmark', { compact, 'fern-only': fernOnly }]} aria-hidden="true">
  {/* The frame is the old typed wordmark's line box: 1em tall with the baseline where the font put it. */}
  <svg class="full" viewBox="32 37.5 863.4 200">
    <g class="letters">
      {LETTERS.map((path) => (
        <path d={path} />
      ))}
    </g>
    <g class="spine">
      <path d={STEM} />
      <path d={COIL} />
    </g>
    <path class="ball" d={BALL} />
    <g class="leaves">
      {LEAVES.map((path) => (
        <path d={path} />
      ))}
    </g>
  </svg>
  <svg class="fern-alone" viewBox="299.8 126.8 100.6 155.3">
    <g class="spine">
      <path d={STEM} />
      <path d={COIL} />
    </g>
    <path class="ball" d={BALL} />
    <g class="leaves">
      {LEAVES.map((path) => (
        <path d={path} />
      ))}
    </g>
  </svg>
</span>

<style>
  .wordmark {
    display: flex;
    line-height: 1;
  }

  /* 863.4 x 200 artwork units at 200 to the em. The ink hangs below the frame (the p's tail), so lift it
     to leave about twice the space above the T as below the p. */
  .full {
    width: 4.317em;
    height: 1em;
    overflow: visible;
    transform: translateY(-0.18em);
  }

  /* The fern's own bounds, 100.6 x 155.3 units. */
  .fern-alone {
    display: none;
    width: 0.503em;
    height: 0.777em;
    overflow: visible;
  }

  .letters {
    fill: var(--text);
  }

  .spine {
    fill: none;
    stroke: var(--accent);
    stroke-width: 13.3137;
    stroke-linecap: round;
  }

  .ball {
    fill: var(--accent);
  }

  .leaves {
    fill: var(--text-muted);
  }

  .fern-only .full {
    display: none;
  }

  .fern-only .fern-alone {
    display: block;
  }

  @media (max-width: 639.98px) {
    .compact .full {
      display: none;
    }

    .compact .fern-alone {
      display: block;
    }
  }
</style>
