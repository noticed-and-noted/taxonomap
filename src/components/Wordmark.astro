---
/**
 * The taxonomap wordmark: Patrick Hand letters with the fiddlehead fern as the first "o".
 * Decorative (the surrounding link carries the label); sized by the parent's font-size.
 */
interface Props {
  /** Below 640 px show the fern alone, as the header does. */
  compact?: boolean;
  /** Show the fern alone at every width. */
  fernOnly?: boolean;
}

const { compact = false, fernOnly = false } = Astro.props;
---

<span class:list={['wordmark', { compact, 'fern-only': fernOnly }]} aria-hidden="true">
  <span class="letters">tax</span>
  {/* The fern stands in for the first "o"; its stem and leaflets hang below the baseline. */}
  <svg viewBox="16 7 32 53" class="fern">
    <g fill="none" stroke="var(--accent)" stroke-width="4.5" stroke-linecap="round">
      <path d="M40.08 58C40.08 47.97 39.88 38.33 32 37.14"></path>
      <path d="M32 37.14C28.68 36.65 24.99 35.58 22.45 33.05C19.92 30.51 18.5 27.08 18.5 23.5C18.5 19.92 19.92 16.49 22.45 13.95C24.99 11.42 28.42 10 32 10C34.78 10 37.4 11.15 39.37 13.12C41.34 15.09 42.37 18.16 42.37 20.95C42.37 23.73 41.05 26.38 38.96 28C36.86 29.62 34.81 29.86 32.43 29.86C31.14 29.86 28.72 29.42 27.3 28C25.88 26.58 24.95 24.42 24.95 22.83C24.95 21.24 25.78 19.01 26.9 17.88C28.03 16.76 30.2 15.62 32.43 16.05"></path>
    </g>
    <path
      d="M33.47 18.93C34.9 18.93 35.97 17.85 35.97 16.43C35.97 15.35 35.17 13.93 33.47 13.93C32.04 13.93 30.97 15 30.97 16.43C30.97 17.85 32.04 18.93 33.47 18.93Z"
      fill="var(--accent)"
    ></path>
    <path
      d="M38.88 50.04C34.33 50.04 29.72 49.22 28.47 43.76C31.74 46.95 36.26 42.65 38.88 50.04Z"
      fill="var(--text-muted)"
    ></path>
    <path
      d="M40.39 46.02C45.86 40.34 46.88 44.08 50.57 40.7C49.84 45.39 45.62 48.3 40.39 46.02Z"
      fill="var(--text-muted)"
    ></path>
  </svg>
  <span class="letters">nomap</span>
</span>

<style>
  /* Sizes are tied to Patrick Hand's x-height (0.467em) so the fern's coil matches the lowercase letters. */
  .wordmark {
    display: flex;
    align-items: baseline;
    font-family: var(--font-hand);
    line-height: 1;
    color: var(--text);
    transform: translateY(-0.12em);
  }

  .fern {
    flex: none;
    width: 0.474em;
    height: 0.786em;
    margin: 0 0.02em;
    overflow: visible;
    transform: translateY(0.308em);
  }

  .fern-only .letters {
    display: none;
  }

  @media (max-width: 639.98px) {
    .compact .letters {
      display: none;
    }
  }
</style>
