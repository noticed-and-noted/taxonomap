---
/**
 * App frame for the interactive routes (/, /tree, /near).
 *
 * The map island sits in a `transition:persist` slot so that it (and its
 * WebGL context, camera and loaded tiles) survives ClientRouter navigation.
 * Visibility is controlled by the non-persisted wrapper, because a persisted
 * element keeps its old attributes across swaps. Panels (side panel /
 * bottom sheet) are rendered by the page's overlay island.
 */
import MapCanvas from './vue/MapCanvas.vue';
import Omnibox from './vue/Omnibox.vue';
import RequestMeter from './vue/RequestMeter.vue';
import StaleNotice from './vue/StaleNotice.vue';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  /** full: map is the page; hidden: map stays alive offscreen (e.g. /tree). */
  map?: 'full' | 'hidden';
}

const { map = 'full' } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const nav = [
  { href: '/', label: 'Map', icon: 'M3 6l6-2 6 2 6-2v14l-6 2-6-2-6 2zM9 4v14M15 6v14' },
  {
    href: '/tree',
    label: 'Tree of life',
    icon: 'M12 21V11M12 11c0-4 3-6 7-6 0 4-3 6-7 6zM12 14c0-3-2.5-5-6-5 0 3 2.5 5 6 5z',
  },
  {
    href: '/near',
    label: 'Near me',
    icon: 'M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11zM12 12.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z',
  },
];
---

<div class="app-shell" data-map={map}>
  <header class="app-header">
    <a href="/" class="brand flex items-center gap-2 font-display text-lg font-semibold tracking-tight">
      <svg
        viewBox="0 0 24 24"
        class="size-6 text-accent"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        aria-hidden="true"
      >
        <circle cx="12" cy="12" r="9"></circle>
        <path d="M3 12h18M12 3c3 3.2 3 14.8 0 18M12 3c-3 3.2-3 14.8 0 18"></path>
      </svg>
      <span class="brand-label">GBIF Explorer</span>
    </a>

    <div class="min-w-0 flex-1">
      <Omnibox client:idle />
    </div>

    <nav aria-label="Main">
      <ul class="flex items-center gap-1 text-sm">
        {nav.map((item) => (
          <li>
            <a
              href={item.href}
              class="flex items-center gap-1.5 rounded-md px-2.5 py-2 text-muted transition-colors duration-200 hover:bg-surface-2 hover:text-text aria-[current=page]:text-text aria-[current=page]:shadow-[inset_0_-2px_0_var(--accent)]"
              aria-current={path === item.href ? 'page' : undefined}
            >
              <svg
                viewBox="0 0 24 24"
                class="nav-icon size-5"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d={item.icon} />
              </svg>
              <span class="nav-label">{item.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <ThemeToggle />
  </header>

  <div class="app-body">
    <div class="map-region" aria-hidden={map === 'hidden' ? 'true' : undefined}>
      <div id="map-slot" class="size-full" transition:persist="map">
        <MapCanvas client:only="vue" />
      </div>
    </div>

    <main id="main" class="app-main" tabindex="-1">
      <slot />
    </main>
  </div>

  <StaleNotice client:idle />
  <RequestMeter client:idle />
</div>

<style>
  .app-shell {
    display: grid;
    grid-template-rows: var(--header-height) 1fr;
    height: 100dvh;
    overflow: hidden;
  }

  .app-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0 0.75rem;
    border-bottom: 1px solid var(--border);
    background: var(--surface);
    z-index: 30;
  }

  .app-body {
    position: relative;
    min-height: 0;
    display: grid;
    grid-template-columns: 1fr;
  }

  .map-region {
    grid-area: 1 / 1;
    min-height: 0;
  }

  .app-shell[data-map='hidden'] .map-region {
    visibility: hidden;
    pointer-events: none;
  }

  .app-main {
    grid-area: 1 / 1;
    min-height: 0;
    position: relative;
    pointer-events: none;
  }

  .app-main > :global(*) {
    pointer-events: auto;
  }

  .app-shell[data-map='hidden'] .app-main {
    pointer-events: auto;
    overflow: auto;
  }

  .nav-icon {
    display: none;
  }

  @media (max-width: 1023.98px) {
    .nav-label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    .nav-icon {
      display: block;
    }
  }

  @media (max-width: 639.98px) {
    .brand-label {
      display: none;
    }
    .app-header {
      gap: 0.375rem;
      padding: 0 0.5rem;
    }
  }
</style>
