---
/**
 * App frame for the interactive routes (/, /tree).
 *
 * The map island sits in a `transition:persist` slot so that it (and its
 * WebGL context, camera and loaded tiles) survives ClientRouter navigation.
 * Visibility is controlled by the non-persisted wrapper, because a persisted
 * element keeps its old attributes across swaps. Panels (side panel /
 * bottom sheet) are rendered by the page's overlay island.
 */
import MapCanvas from './vue/MapCanvas.vue';
import RequestMeter from './vue/RequestMeter.vue';
import StaleNotice from './vue/StaleNotice.vue';
import SiteHeader from './SiteHeader.astro';
import type { SearchMode } from './vue/Omnibox.vue';

interface Props {
  /** full: map is the page; hidden: map stays alive offscreen (e.g. /tree). */
  map?: 'full' | 'hidden';
  /** What picking a search result does (the map adds it; the tree moves to it). */
  search: SearchMode;
}

const { map = 'full', search } = Astro.props;
---

<div class="app-shell" data-map={map}>
  <SiteHeader search={search} />

  <div class="app-body">
    <div class="map-region" aria-hidden={map === 'hidden' ? 'true' : undefined}>
      <div id="map-slot" class="size-full" transition:persist="map">
        <MapCanvas client:only="vue" />
      </div>
    </div>

    <main id="main" class="app-main" tabindex="-1">
      <slot />
    </main>
  </div>

  <StaleNotice client:idle onMap={map === 'full'} />
  <RequestMeter client:idle />
</div>

<style>
  .app-shell {
    position: relative;
    display: grid;
    height: 100dvh;
    /* clip, not hidden: hidden still lets focus and scrollIntoView scroll it, shifting the whole map page. */
    overflow: clip;
  }

  /* The header floats over the full-bleed map. */
  .app-shell > :global(.app-header) {
    position: absolute;
    inset: 0 0 auto;
  }

  .app-body {
    position: relative;
    min-height: 0;
    display: grid;
    grid-template-columns: 1fr;
  }

  .map-region {
    grid-area: 1 / 1;
    min-height: 0;
  }

  .app-shell[data-map='hidden'] .map-region,
  .app-shell[data-map='hidden'] .map-region :global(*) {
    /* MapLibre controls set their own visibility; keep the whole map hidden. */
    visibility: hidden !important;
    pointer-events: none;
  }

  .app-main {
    grid-area: 1 / 1;
    margin-top: var(--header-offset);
    min-height: 0;
    position: relative;
    pointer-events: none;
  }

  .app-main > :global(*) {
    pointer-events: auto;
  }

  .app-shell[data-map='hidden'] .app-main {
    pointer-events: auto;
    overflow: auto;
  }
</style>
