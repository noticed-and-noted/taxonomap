---
/** Frame for the privacy and terms pages: a readable column of headed sections with the last-updated date. */
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageShell from './PageShell.astro';

interface Props {
  title: string;
  description: string;
  /** When the text last changed, written out (e.g. "22 October 2026"). */
  updated: string;
}

const { title, description, updated } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <PageShell>
    <article class="prose mx-auto max-w-2xl px-4 py-12">
      <h1 class="font-display text-4xl">{title}</h1>
      <p class="mt-2 text-sm text-subtle">Last updated {updated}</p>
      <slot />
    </article>
  </PageShell>
</BaseLayout>
