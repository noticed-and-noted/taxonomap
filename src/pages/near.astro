---
import AppShell from '~/components/AppShell.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
---

<BaseLayout title="What’s near me" description="See which species have been recorded around you.">
  <AppShell map="hidden" panel={false}>
    <section class="mx-auto max-w-3xl px-4 py-10">
      <h1 class="font-display text-3xl">What’s near me</h1>
      <p class="mt-3 text-muted">Location-based species lists arrive in Phase 5.</p>
    </section>
  </AppShell>
</BaseLayout>
