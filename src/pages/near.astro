---
/** "Near me" is now a mode of the map page; keep old links (with their query) working. */
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content="0; url=/?near=1" />
    <title>What’s near me · Taxonomap</title>
    <script is:inline>
      location.replace('/?near=1' + location.search.replace(/^\?/, '&') + location.hash);
    </script>
  </head>
  <body>
    <a href="/?near=1">What’s near me</a>
  </body>
</html>
