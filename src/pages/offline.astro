---
import Wordmark from '~/components/Wordmark.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
---

<BaseLayout title="Offline" noindex>
  {/* The service worker serves this at whatever URL was asked for, so reloading tries that page again. */}
  <main id="main" class="offline-page" data-offline-page>
    <Wordmark fernOnly />
    <h1 class="mt-8 font-display text-4xl">You’re offline</h1>
    <p class="mt-3 text-muted">
      Taxonomap needs a connection.
      <br />
      This page reloads when you’re back online.
    </p>
    <button type="button" class="mt-8 rounded-md bg-accent px-5 py-2.5 font-medium text-accent-contrast" data-try-again>
      Try again
    </button>
  </main>
</BaseLayout>

<script>
  const tryAgain = () => {
    if (document.querySelector('[data-offline-page]')) window.location.reload();
  };

  document.querySelector('[data-try-again]')?.addEventListener('click', tryAgain);
  window.addEventListener('online', tryAgain);
</script>

<style>
  .offline-page {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 2rem 1rem;
    text-align: center;
  }

  .offline-page :global(.wordmark) {
    font-size: 6rem;
  }
</style>
