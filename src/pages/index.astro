---
import ExplorerOverlay from '~/components/views/ExplorerOverlay.vue';
import AppShell from '~/layouts/AppShell.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';

// Tells search engines what the app is; the Organization lives on taxonomap.com.
const STRUCTURED_DATA = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  '@id': 'https://app.taxonomap.com/#app',
  name: 'Taxonomap',
  url: 'https://app.taxonomap.com/',
  description: 'The Taxonomap application',
  applicationCategory: 'ReferenceApplication',
  operatingSystem: 'Web',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'GBP' },
  // Named here too: search engines don't reliably follow an @id to another domain.
  publisher: {
    '@type': 'Organization',
    '@id': 'https://taxonomap.com/#organization',
    name: 'Taxonomap',
    url: 'https://taxonomap.com/',
  },
};
---

<BaseLayout title="Taxonomap app" description="The Taxonomap application">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(STRUCTURED_DATA).replace(/</g, '\\u003c')} />
  <AppShell map="full" search="map">
    <h1 class="sr-only">Global map of species occurrence records</h1>
    <ExplorerOverlay client:only="vue" />
  </AppShell>
</BaseLayout>
