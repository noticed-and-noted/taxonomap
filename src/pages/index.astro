---
import AppShell from '~/components/AppShell.astro';
import ExplorerOverlay from '~/components/vue/ExplorerOverlay.vue';
import BaseLayout from '~/layouts/BaseLayout.astro';
---

<BaseLayout title="Taxonomap: Explore species records from around the world">
  <AppShell map="full" search="map">
    <h1 class="sr-only">Global map of species occurrence records</h1>
    <ExplorerOverlay client:only="vue" />
  </AppShell>
</BaseLayout>
