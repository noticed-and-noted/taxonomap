---
/**
 * Pre-rendered species page (top SPECIES_PRERENDER_COUNT species). Static
 * HTML at build; only the gallery, similar species, mini-map, charts and name meanings hydrate.
 * Photos are never fetched at build: the gallery and similar species cards
 * look them up in the browser (see ~/lib/photos/taxon-photos).
 */
import PlotChart from '~/components/molecules/PlotChart.vue';
import RadialSeasonality from '~/components/molecules/RadialSeasonality.vue';
import LiveNameMeaning from '~/components/organisms/species/LiveNameMeaning.vue';
import MiniMap from '~/components/organisms/species/MiniMap.vue';
import SimilarSpecies from '~/components/organisms/species/SimilarSpecies.vue';
import SpeciesGallery from '~/components/organisms/species/SpeciesGallery.vue';
import SpeciesPage from '~/components/organisms/species/SpeciesPage.vue';
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageShell from '~/layouts/PageShell.astro';
import { bakeSpeciesList, bakeSpeciesManifest, bakedSpeciesPage } from '~/lib/bake';
import { full } from '~/lib/format';
import { speciesCharts } from '~/lib/species/charts';
import { speciesJsonLd } from '~/lib/species/json-ld';
import { similarItems } from '~/lib/species/links';

export async function getStaticPaths() {
  const list = await bakeSpeciesList();
  return list.map((species) => ({ params: { key: String(species.key), slug: species.slug } }));
}

const key = Number(Astro.params.key);
const [{ data, intro }, manifest] = await Promise.all([bakedSpeciesPage(key), bakeSpeciesManifest()]);

const label = data.commonName ?? data.canonicalName;
const charts = speciesCharts(data);
const title = data.commonName ? `${data.commonName} (${data.canonicalName})` : data.canonicalName;
const topCountries = data.countries
  .slice(0, 3)
  .map(([countryCode]) => countryCode)
  .join(', ');
const description =
  `${title}: ${full(data.count)} occurrence records on GBIF` +
  (topCountries ? `, most from ${topCountries}` : '') +
  '. See where and when it has been recorded, photos, common names and similar species.';

const siteUrl = String(Astro.site);
const jsonLd = speciesJsonLd({
  data,
  pageUrl: new URL(Astro.url.pathname, siteUrl).href,
  siteUrl,
  description,
  wikipediaUrl: intro?.url,
});
---

<BaseLayout title={title} description={description} ogImage={`/og/species/${key}.png`}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />
  <PageShell>
    <SpeciesPage data={data} intro={intro}>
      <LiveNameMeaning slot="meaning" client:idle canonicalName={data.canonicalName} />
      <SpeciesGallery slot="gallery" client:load taxonKey={data.key} rank={data.rank} name={label} />
      {data.siblings.length > 0 && (
        <SimilarSpecies slot="similar" client:visible species={similarItems(data.siblings, manifest)} />
      )}
      {data.count > 0 && <MiniMap slot="map" client:visible taxonKey={data.key} label={label} />}
      <PlotChart slot="years" client:visible kind="years" title="Records per year" years={data.years} />
      <RadialSeasonality slot="months" client:visible counts={data.months} size={240} title="Records by month" />
      <PlotChart
        slot="countries"
        client:visible
        kind="bars"
        title="Top countries"
        bars={charts.countries}
        total={data.count}
      />
      <PlotChart
        slot="datasets"
        client:visible
        kind="bars"
        title="Top datasets"
        caption="publishers of the records"
        bars={charts.datasets}
        total={data.count}
      />
    </SpeciesPage>
  </PageShell>
</BaseLayout>
