---
/**
 * Client-rendered fallback for species without a pre-rendered page.
 * Same components as /species/[key]/[slug]; not indexed.
 */
import SpeciesSkeleton from '~/components/organisms/species/SpeciesSkeleton.vue';
import SpeciesView from '~/components/views/SpeciesView.vue';
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageShell from '~/layouts/PageShell.astro';
---

<BaseLayout title="Species" noindex>
  <PageShell>
    <SpeciesView client:only="vue">
      <SpeciesSkeleton slot="fallback" />
    </SpeciesView>
  </PageShell>
</BaseLayout>
