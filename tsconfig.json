{
  "extends": "astro/tsconfigs/strictest",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist", "node_modules", ".cache", "playwright-report", "test-results"],
  "compilerOptions": {
    "paths": {
      "~/*": ["./src/*"]
    },
    "jsx": "preserve",
    "types": ["node", "vitest/globals", "geojson"]
  }
}
